<launch>
  <!-- Arguments -->
  <arg name="map_file" default="$(find robot_navigation)/maps/map.yaml"/>
  <arg name="simulation" default="false"/>
  <arg name="planner" default="teb" doc="opt: dwa, teb"/>
  <arg name="open_rviz" default="false"/>
  <arg name="lidar_mode" default="Boost"/>

  <!-- Base control / EKF / TEB 相关统一参数 -->
  <arg name="wheelbase" default="0.21"/>
  <arg name="min_cmd_vel_x" default="0.03"/>
  <arg name="is_pub_odom_tf" default="false"/>
  <arg name="is_send_anger" default="false"/>

  <!-- yaw 和 vyaw 方向修正参数
       默认 -1.0 是为了保持你原代码中 Yawz 取反的逻辑，并让 Vyaw 同步取反。
       如果实测逆时针左转时 /imu_data/angular_velocity.z 为负，
       就把 yaw_sign 和 vyaw_sign 一起改成 1.0。 -->
  <arg name="yaw_sign" default="-1.0"/>
  <arg name="vyaw_sign" default="-1.0"/>

  <!-- 里程计话题：建议用相对话题，兼容 /slave 命名空间 -->
  <arg name="odom_topic" default="odometry/filtered"/>


  <!-- ========================================================= -->
  <!-- Simulation -->
  <!-- ========================================================= -->
  <group if="$(arg simulation)">
    <!-- simulation robot with lidar and map -->
    <include file="$(find robot_navigation)/simulation/simulation.launch"/>
  </group>


  <!-- ========================================================= -->
  <!-- Real Robot -->
  <!-- ========================================================= -->
  <group unless="$(arg simulation)">

    <node pkg="tf" type="static_transform_publisher" name="base_to_link"
          args="0.00 0 0 0 0 0 base_footprint base_link 100" />

    <node pkg="tf" type="static_transform_publisher" name="base_to_gyro"
          args="0.08 0 0 0 0 0 base_link IMU_link 100" />

    <node pkg="tf" type="static_transform_publisher" name="base_to_laser"
          args="0.14 0 0.11 0 0 0 base_link base_laser_link 100" />

    <node pkg="tf" type="static_transform_publisher" name="base_to_camera"
          args="0.14 0 0.11 0 0 0 base_link camera_link 100" />


    <include file="$(find robot_navigation)/launch/robot_lidar.launch">
      <arg name="lidar_mode" value="$(arg lidar_mode)"/>

      <!-- 传给 art_racecar.py 的关键参数 -->
      <arg name="wheelbase" value="$(arg wheelbase)"/>
      <arg name="min_cmd_vel_x" value="$(arg min_cmd_vel_x)"/>
      <arg name="is_pub_odom_tf" value="$(arg is_pub_odom_tf)"/>
      <arg name="is_send_anger" value="$(arg is_send_anger)"/>
      <arg name="yaw_sign" value="$(arg yaw_sign)"/>
      <arg name="vyaw_sign" value="$(arg vyaw_sign)"/>
    </include>


    <node pkg="map_server" name="map_server" type="map_server" args="$(arg map_file)">
      <param name="frame_id" value="map"/>
    </node>


    <!--
      EKF 输入：
        odom
        imu_data

      EKF 输出：
        odometry/filtered
        TF: odom -> base_footprint

      注意：
        art_racecar.py 必须 is_pub_odom_tf=false，
        否则会和 EKF 同时发布 odom -> base_footprint，导致 TF 冲突。
    -->
    <node name="ekf_se"
          pkg="robot_localization"
          type="ekf_localization_node"
          clear_params="true"
          output="screen">
      <rosparam command="load" file="$(find robot_navigation)/param/EPRobot/ekf_params.yaml"/>
    </node>


    <!--
      AMCL 使用：
        map
        scan_filtered
        TF: odom -> base_footprint

      AMCL 发布：
        TF: map -> odom

      不需要 remap /odom。
    -->
    <node pkg="amcl" type="amcl" name="amcl" output="screen">
      <rosparam file="$(find robot_navigation)/param/EPRobot/amcl_params.yaml" command="load"/>

      <param name="initial_pose_x" value="0.0"/>
      <param name="initial_pose_y" value="0.0"/>
      <param name="initial_pose_a" value="0.0"/>

      <remap from="scan" to="scan_filtered"/>
    </node>

  </group>


  <!-- ========================================================= -->
  <!-- move_base -->
  <!-- ========================================================= -->
  <include file="$(find robot_navigation)/launch/move_base.launch">
    <arg name="planner" value="$(arg planner)"/>
    <arg name="simulation" value="$(arg simulation)"/>

    <!-- 局部规划器使用 EKF 输出的融合里程计 -->
    <arg name="odom_topic" value="$(arg odom_topic)"/>
  </include>


  <!-- ========================================================= -->
  <!-- RViz -->
  <!-- ========================================================= -->
  <group if="$(arg open_rviz)">
    <node pkg="rviz" type="rviz" name="rviz" required="true"
          args="-d $(find robot_navigation)/rviz/navigation.rviz"/>
  </group>

</launch>
