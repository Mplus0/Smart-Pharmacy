<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- test_move_to_waypoint.launch -->

  <arg name="car_id" default="1"/>
  <arg name="target" default="A"/>
  <arg name="timeout_sec" default="60"/>
  <arg name="wait_server_sec" default="30"/>
  <arg name="clear_costmaps" default="true"/>
  <arg name="dry_run" default="false"/>
  <arg name="output" default="screen"/>

  <node name="test_move_to_waypoint"
        pkg="pharmacy_pkg"
        type="test_move_to_waypoint.py"
        output="$(arg output)">
    <env name="CAR_ID" value="$(arg car_id)"/>
    <param name="target" value="$(arg target)"/>
    <param name="timeout_sec" value="$(arg timeout_sec)"/>
    <param name="wait_server_sec" value="$(arg wait_server_sec)"/>
    <param name="clear_costmaps" value="$(arg clear_costmaps)"/>
    <param name="dry_run" value="$(arg dry_run)"/>
  </node>
</launch>
