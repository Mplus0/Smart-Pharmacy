<launch>
  <!-- Reuse the running navigation and camera. One complete delivery cycle. -->
  <arg name="max_rounds" default="1"/>
  <arg name="start_referee" default="false"/>
  <include file="$(find pharmacy_ISCC)/launch/pharmacy_main.launch">
    <arg name="car_id" value="1"/>
    <arg name="start_dual_tcp" value="false"/>
    <arg name="enable_dual_car" value="false"/>
    <arg name="max_rounds" value="$(arg max_rounds)"/>
    <arg name="respawn_detect" value="false"/>
  </include>
  <include if="$(arg start_referee)" file="$(find pharmacy_ISCC)/launch/referee_only.launch">
    <arg name="car_id" value="1"/>
  </include>
</launch>
