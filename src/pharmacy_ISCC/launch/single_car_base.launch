<launch>
  <!-- Terminal 1: hardware, navigation, camera, video and optional X11 RViz. -->
  <arg name="open_rviz" default="true"/>
  <include file="$(find robot_navigation)/launch/robot_navigation.launch">
    <arg name="planner" value="teb"/>
    <arg name="open_rviz" value="$(arg open_rviz)"/>
  </include>
  <include file="$(find astra_camera)/launch/astra.launch"/>
  <node pkg="web_video_server" type="web_video_server"
        name="web_video_server" output="screen"/>
</launch>
