<launch>
  <!-- 主业务：视觉识别、导航状态机及可选双车通信。 -->

  <arg name="enable_dual_car" default="false"/>
  <arg name="max_rounds" default="1"/>
  <arg name="car_id" default="1" doc="车辆编号：1 或 2"/>
  <arg name="output" default="screen" doc="节点日志输出：screen 或 log"/>

  <!-- 主业务节点 -->
  <arg name="start_dual_tcp" default="true" doc="启动双车 TCP 通信节点"/>
  <arg name="start_detect" default="true" doc="启动视觉识别节点"/>
  <arg name="start_nav_pharmacy" default="true" doc="启动药房导航状态机节点"/>

  <arg name="respawn_comm" default="true"/>
  <arg name="respawn_detect" default="true"/>
  <arg name="respawn_nav_pharmacy" default="false"/>

  <!-- 先启动其他节点，最后再启动识别和药房状态机 -->
  <arg name="detect_start_delay" default="3" doc="视觉识别节点延时启动秒数"/>
  <arg name="nav_start_delay" default="6" doc="药房状态机延时启动秒数"/>

  <!-- 双车 done 建议重复发布，降低瞬时漏收风险 -->
  <arg name="dual_publish_repeat" default="3"/>
  <arg name="dual_publish_interval" default="0.10"/>

  <!-- 双车 TCP 先启动 -->
  <node if="$(arg start_dual_tcp)"
        name="dual_car_tcp_link"
        pkg="pharmacy_ISCC"
        type="tcp_link_v2.py"
        output="$(arg output)"
        respawn="$(arg respawn_comm)">
    <env name="CAR_ID" value="$(arg car_id)"/>
  </node>

  <!-- 视觉识别节点后启动，但早于药房状态机 -->
  <node if="$(arg start_detect)"
        name="detect_abc"
        pkg="pharmacy_ISCC"
        type="F1_detect_code_v5.py"
        output="$(arg output)"
        respawn="$(arg respawn_detect)"
        launch-prefix="bash -c 'sleep $(arg detect_start_delay); exec &quot;$@&quot;' _">
    <env name="CAR_ID" value="$(arg car_id)"/>
  </node>

  <!-- 药房导航状态机最后启动 -->
  <node if="$(arg start_nav_pharmacy)"
        name="nav_pharmacy"
        pkg="pharmacy_ISCC"
        type="F1_yaofang_v5.py"
        output="$(arg output)"
        respawn="$(arg respawn_nav_pharmacy)"
        launch-prefix="bash -c 'sleep $(arg nav_start_delay); exec &quot;$@&quot;' _">
    <env name="CAR_ID" value="$(arg car_id)"/>
    <param name="enable_dual_car" value="$(arg enable_dual_car)"/>
    <param name="max_rounds" value="$(arg max_rounds)"/>
    <param name="dual_publish_repeat" value="$(arg dual_publish_repeat)"/>
    <param name="dual_publish_interval" value="$(arg dual_publish_interval)"/>
  </node>
</launch>
