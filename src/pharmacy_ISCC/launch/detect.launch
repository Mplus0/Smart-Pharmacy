<launch>
  <!-- Standalone recognition; results/state are isolated from competition. -->
  <arg name="car_id" default="1"/>
  <arg name="state" default="10" doc="10: board1; 13: board2 (configured TCP or vision source)"/>
  <arg name="board2_result_source" default="" doc="empty: config; tcp, vision or yolo"/>
  <arg name="speak_board2" default="false"/>
  <arg name="camera_fallback_to_http" default="true"/>
  <arg name="record_dir" default="$(env HOME)/.ros/pharmacy_ISCC/vision_debug"/>
  <node unless="$(arg speak_board2)" pkg="rostopic" type="rostopic" name="vision_debug_state"
        args="pub -l /pharmacy_vision_debug/nav_state std_msgs/Int32 'data: $(arg state)'"/>
  <node pkg="pharmacy_ISCC" type="F1_detect_code_v5.py"
        name="vision_debug" output="screen">
    <env name="CAR_ID" value="$(arg car_id)"/>
    <env name="PHARMACY_RECORD_DIR" value="$(arg record_dir)"/>
    <param name="board2_result_source" value="$(arg board2_result_source)"/>
    <param name="camera_fallback_to_http" value="$(arg camera_fallback_to_http)"/>
    <remap from="/nav_state" to="/pharmacy_vision_debug/nav_state"/>
    <remap from="/cam_return" to="/pharmacy_vision_debug/cam_return"/>
    <remap from="/board2_return" to="/pharmacy_vision_debug/board2_return"/>
    <remap from="/board1_all_text" to="/pharmacy_vision_debug/board1_all_text"/>
  </node>
  <node if="$(arg speak_board2)" pkg="pharmacy_ISCC" type="board2_visual_test.py"
        name="board2_visual_audio" output="screen">
    <env name="CAR_ID" value="$(arg car_id)"/>
    <env name="PHARMACY_RECORD_DIR" value="$(arg record_dir)"/>
    <param name="state" value="$(arg state)"/>
  </node>
</launch>
