<launch>
  <!--
    referee_only.launch
    裁判通信单独启动文件。

    一号车：
      roslaunch pharmacy_pkg referee_only.launch car_id:=1

    二号车：
      roslaunch pharmacy_pkg referee_only.launch car_id:=2

    说明：
      这个 launch 只启动 referee_client_v3.py。
      建议单独开一个终端运行，避免裁判通信高频打印影响主业务日志阅读。
  -->

  <arg name="car_id" default="1" doc="车辆编号：1 或 2"/>
  <arg name="output" default="screen" doc="节点日志输出：screen 或 log"/>
  <arg name="respawn_referee" default="true"/>

  <node name="referee_client_node"
        pkg="pharmacy_pkg"
        type="referee_client_v3.py"
        output="$(arg output)"
        respawn="$(arg respawn_referee)">
    <env name="CAR_ID" value="$(arg car_id)"/>
  </node>
</launch>
