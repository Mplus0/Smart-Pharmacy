<launch>
  <!--
    pharmacy_main_no_referee.launch
    主业务启动文件：不启动裁判通信节点，避免裁判通信高频日志刷屏。

    推荐启动：
      一号车主业务：
        roslaunch pharmacy_pkg pharmacy_main_no_referee.launch car_id:=1

      二号车主业务：
        roslaunch pharmacy_pkg pharmacy_main_no_referee.launch car_id:=2

    裁判通信请另开终端启动：
        roslaunch pharmacy_pkg referee_only.launch car_id:=1
        roslaunch pharmacy_pkg referee_only.launch car_id:=2
  -->

  <arg name="car_id" default="1" doc="车辆编号：1 或 2"/>
  <arg name="output" default="screen" doc="节点日志输出：screen 或 log"/>

  <!-- 基础系统 -->
  <arg name="start_base" default="true" doc="是否启动基础系统"/>
  <arg name="start_navigation" default="true" doc="是否启动 robot_navigation / robot_race_init"/>
  <arg name="start_camera" default="true" doc="是否启动 Astra 摄像头驱动"/>
  <arg name="start_video_server" default="true" doc="是否启动 web_video_server"/>
  <arg name="use_race_init" default="true" doc="true 使用 robot_race_init.launch；false 使用 robot_navigation.launch"/>

  <!-- 主业务节点 -->
  <arg name="start_dual_tcp" default="true" doc="启动双车 TCP 通信节点"/>
  <arg name="start_detect" default="true" doc="启动视觉识别节点"/>
  <arg name="start_nav_pharmacy" default="true" doc="启动药房导航状态机节点"/>

  <arg name="respawn_comm" default="true"/>
  <arg name="respawn_detect" default="true"/>
  <arg name="respawn_nav_pharmacy" default="false"/>

  <!-- 先启动其他节点，最后再启动识别和药房状态机 -->
  <arg name="detect_start_delay" default="3" doc="视觉识别节点延时启动秒数"/>
  <arg name="nav_start_delay" default="6" doc="药房状态机延时启动秒数"/>

  <!-- 双车 done 建议重复发布，降低瞬时漏收风险 -->
  <arg name="dual_publish_repeat" default="3"/>
  <arg name="dual_publish_interval" default="0.10"/>

  <!-- =========================================================
       基础系统：底盘 + 导航 + 摄像头驱动 + HTTP 视频流
       ========================================================= -->
  <group if="$(arg start_base)">
    <group if="$(arg start_navigation)">
      <include unless="$(arg use_race_init)"
               file="$(find robot_navigation)/launch/robot_navigation.launch">
        <arg name="planner" value="teb"/>
        <arg name="open_rviz" value="false"/>
      </include>

      <include if="$(arg use_race_init)"
               file="$(find robot_navigation)/launch/robot_race_init.launch">
        <arg name="planner" value="teb"/>
        <arg name="open_rviz" value="false"/>
      </include>
    </group>

    <group if="$(arg start_camera)">
      <include file="$(find astra_camera)/launch/astra.launch"/>
    </group>

    <group if="$(arg start_video_server)">
      <node name="web_video_server"
            pkg="web_video_server"
            type="web_video_server"
            output="$(arg output)"/>
    </group>
  </group>

  <!-- 双车 TCP 先启动 -->
  <node if="$(arg start_dual_tcp)"
        name="dual_car_tcp_link"
        pkg="pharmacy_pkg"
        type="tcp_link_v2.py"
        output="$(arg output)"
        respawn="$(arg respawn_comm)">
    <env name="CAR_ID" value="$(arg car_id)"/>
  </node>

  <!-- 视觉识别节点后启动，但早于药房状态机 -->
  <node if="$(arg start_detect)"
        name="detect_abc"
        pkg="pharmacy_pkg"
        type="F1_detect_code_v5.py"
        output="$(arg output)"
        respawn="$(arg respawn_detect)"
        launch-prefix="bash -c 'sleep $(arg detect_start_delay); exec &quot;$@&quot;' _">
    <env name="CAR_ID" value="$(arg car_id)"/>
  </node>

  <!-- 药房导航状态机最后启动 -->
  <node if="$(arg start_nav_pharmacy)"
        name="nav_pharmacy"
        pkg="pharmacy_pkg"
        type="F1_yaofang_v5.py"
        output="$(arg output)"
        respawn="$(arg respawn_nav_pharmacy)"
        launch-prefix="bash -c 'sleep $(arg nav_start_delay); exec &quot;$@&quot;' _">
    <env name="CAR_ID" value="$(arg car_id)"/>
    <param name="dual_publish_repeat" value="$(arg dual_publish_repeat)"/>
    <param name="dual_publish_interval" value="$(arg dual_publish_interval)"/>
  </node>
</launch>
