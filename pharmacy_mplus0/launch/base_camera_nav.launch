<launch>
  <!--
    base_camera_nav.launch — 基础系统启动文件

    将底盘、导航、摄像头和 web_video_server 的启动整合到一起，
    不启动任何智慧药房业务节点。

    等效命令:
      roslaunch robot_navigation robot_navigation.launch
      roslaunch astra_camera astra.launch
      rosrun web_video_server web_video_server

    用途:
      - 赛前启动本文件，确认定位、导航、视频流正常。

    开关参数:
      start_navigation:    启动导航 (robot_navigation 或 robot_race_init)。
      start_camera:        启动 Astra 摄像头。
      start_video_server:  启动 web_video_server HTTP 视频流。
      use_race_init:       使用 robot_race_init.launch 替代默认的 robot_navigation.launch。
  -->

  <arg name="start_navigation"   default="true" doc="启动导航"/>
  <arg name="start_camera"       default="true" doc="启动摄像头"/>
  <arg name="start_video_server" default="true" doc="启动 web_video_server"/>
  <arg name="use_race_init"      default="false" doc="使用 robot_race_init.launch 替代 robot_navigation.launch"/>
  <arg name="planner"            default="teb" doc="路径规划器: dwa / teb"/>

  <!-- ── 导航（底盘 + 激光雷达 + 定位 + move_base + EKF）─ -->
  <group if="$(arg start_navigation)">
    <include unless="$(arg use_race_init)"
             file="$(find robot_navigation)/launch/robot_navigation.launch">
      <arg name="planner" value="$(arg planner)"/>
      <arg name="open_rviz" value="false"/>
    </include>
    <include if="$(arg use_race_init)"
             file="$(find robot_navigation)/launch/robot_race_init.launch">
      <arg name="planner" value="$(arg planner)"/>
      <arg name="open_rviz" value="false"/>
    </include>
  </group>

  <!-- ── 摄像头（Astra RGB-D）────────────────────── -->
  <group if="$(arg start_camera)">
    <include file="$(find astra_camera)/launch/astra.launch"/>
  </group>

  <!-- ── HTTP 视频流（供识别节点通过 cv2 读取）───── -->
  <group if="$(arg start_video_server)">
    <node name="web_video_server"
          pkg="web_video_server" type="web_video_server"
          output="screen"/>
  </group>

</launch>
