<launch>
  <!--
    base_camera_nav.launch — 基础系统启动文件

    只启动底盘、导航、摄像头和 web_video_server，
    不启动任何智慧药房业务节点。

    用途:
      - 赛前先启动本文件，确认定位、导航、视频流正常。
      - race_bringup.launch 会 include 本文件，再 include main.launch。

    开关参数:
      start_base:          启动底盘（eprobot_start）。
      start_navigation:    启动导航（robot_navigation）。
      start_camera:        启动 Astra 摄像头。
      start_video_server:  启动 web_video_server HTTP 视频流。
      planner:             路径规划器 (dwa / teb)。
  -->

  <!-- ── 开关参数 ───────────────────────────────── -->
  <arg name="start_base"         default="true" doc="启动底盘"/>
  <arg name="start_navigation"   default="true" doc="启动导航"/>
  <arg name="start_camera"       default="true" doc="启动摄像头"/>
  <arg name="start_video_server" default="true" doc="启动 web_video_server"/>
  <arg name="planner"            default="teb"  doc="路径规划器: dwa 或 teb"/>

  <!-- ── 底盘（base_control + TF + 激光雷达）─────── -->
  <group if="$(arg start_base)">
    <include file="$(find eprobot_start)/launch/EPRobot_start.launch"/>
  </group>

  <!-- ── 导航（AMCL + move_base + map_server + EKF）─ -->
  <group if="$(arg start_navigation)">
    <include file="$(find robot_navigation)/launch/robot_navigation.launch">
      <arg name="planner" value="$(arg planner)"/>
      <arg name="open_rviz" value="false"/>
    </include>
  </group>

  <!-- ── 摄像头（Astra RGB-D）────────────────────── -->
  <group if="$(arg start_camera)">
    <include file="$(find astra_camera)/launch/astra.launch">
      <arg name="camera" default="camera"/>
    </include>
  </group>

  <!-- ── HTTP 视频流（供识别节点通过 cv2 读取）───── -->
  <group if="$(arg start_video_server)">
    <node name="web_video_server"
          pkg="web_video_server" type="web_video_server"
          output="screen"/>
  </group>

</launch>
