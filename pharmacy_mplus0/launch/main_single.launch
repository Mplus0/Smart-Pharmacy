<launch>
  <!--
    main_single.launch — 单车静默调试/比赛模式

    与 main.launch 基本一致，唯一区别:
      audio_dir 默认为空，保留 TCP 上报但不播放音频。
    适用于调试场景或双车中的跟车（只报不播）。

    同样不启动底盘、导航、摄像头和 web_video_server。
  -->

  <arg name="stream_url"
       default="http://192.168.124.3:8080/stream?topic=/camera/rgb/image_raw"/>
  <arg name="server_ip"   default="192.168.124.2"/>
  <arg name="server_port" default="9999"/>
  <arg name="car_id"      default="1"/>
  <arg name="audio_dir"   default=""/>

  <!-- 复用 main.launch 的全部节点定义，仅覆盖 audio_dir -->
  <include file="$(find pharmacy_mplus0)/launch/main.launch">
    <arg name="stream_url"  value="$(arg stream_url)"/>
    <arg name="server_ip"   value="$(arg server_ip)"/>
    <arg name="server_port" value="$(arg server_port)"/>
    <arg name="car_id"      value="$(arg car_id)"/>
    <arg name="audio_dir"   value="$(arg audio_dir)"/>
  </include>

</launch>
