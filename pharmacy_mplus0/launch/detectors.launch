<launch>
  <!--
    detectors.launch — 只启动两个识别节点

    用途:
      - 单独验证摄像头和识别算法。
      - 调整 vision.yaml 参数后快速重启测试。
      - 不启动主控，小车不会运动，安全。

    发布话题:
      /cam_return, /all_qrcodes, /board1_detections  (识别板一)
      /cv1_result, /board2_status                     (识别板二)
  -->

  <arg name="stream_url"
       default="http://192.168.12.1:8080/stream?topic=/camera/rgb/image_raw"
       doc="HTTP 视频流地址"/>

  <!-- 识别板一 -->
  <node name="board1_detector"
        pkg="pharmacy_mplus0" type="board1_detector.py"
        output="screen" respawn="true">
    <param name="stream_url" value="$(arg stream_url)"/>
  </node>

  <!-- 识别板二 -->
  <node name="board2_detector"
        pkg="pharmacy_mplus0" type="board2_detector.py"
        output="screen" respawn="true">
    <param name="stream_url" value="$(arg stream_url)"/>
  </node>

</launch>
