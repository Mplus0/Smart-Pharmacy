<launch>
  <!--
    test_navigation.launch — 启动单航点导航测试

    用途: 逐个验证 waypoints.yaml 中每个航点的导航精度。
    需要先启动底盘和导航基础系统。

    用法:
      roslaunch pharmacy_mplus0_debug test_navigation.launch target:=exam_A
      roslaunch pharmacy_mplus0_debug test_navigation.launch target:=lab_1
  -->

  <arg name="target" default="board1"
       doc="目标航点名称: start / board1 / board2 / exam_A~C / lab_1~4"/>
  <arg name="clear" default="true"
       doc="导航前是否清理代价地图"/>

  <node name="waypoint_tester"
        pkg="pharmacy_mplus0_debug" type="waypoint_tester.py"
        output="screen" required="true">
    <param name="target" value="$(arg target)"/>
    <param name="clear"  value="$(arg clear)"/>
  </node>

</launch>
