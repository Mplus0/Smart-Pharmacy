<launch>
  <!--
    test_voice.launch — 测试 wav 音频播放

    用途: 向 /announce_request 发布音频事件 ID，
    触发 tcp_reporter 中的 AudioAnnouncer 播放 wav。

    用法:
      roslaunch pharmacy_mplus0_debug test_voice.launch
      roslaunch pharmacy_mplus0_debug test_voice.launch announce:=board2_busy_8
  -->

  <arg name="audio_dir"
       default="$(find pharmacy_mplus0)/audio"
       doc="wav 音频文件目录"/>
  <arg name="audio_player"  default="aplay"         doc="音频播放器"/>
  <arg name="allow_overlap" default="false"         doc="是否允许重叠播放"/>
  <arg name="announce"      default="board2_idle"   doc="测试音频事件 ID"/>

  <!-- 音频播报节点 -->
  <node name="tcp_reporter"
        pkg="pharmacy_mplus0" type="tcp_reporter.py"
        output="screen">
    <param name="audio_dir"     value="$(arg audio_dir)"/>
    <param name="audio_player"  value="$(arg audio_player)"/>
    <param name="allow_overlap" value="$(arg allow_overlap)"/>
    <param name="server_ip"     value="127.0.0.1"/>
    <param name="server_port"   value="8888"/>
  </node>

  <!-- 发送测试音频事件 ID -->
  <node name="send_test_announce"
        pkg="pharmacy_mplus0_debug" type="send_fake_task.py"
        output="screen">
    <param name="announce" value="$(arg announce)"/>
  </node>

</launch>
