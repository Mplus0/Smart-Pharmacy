<launch>
  <!--
    test_reporter.launch — 启动 TCP 假服务端 + tcp_reporter 验证上报

    用途: 在没有裁判软件时验证 TCP 上报格式和频率。
    假服务端在 0.0.0.0:8888 监听，接收并打印每条 JSON。

    用法:
      roslaunch pharmacy_mplus0_debug test_reporter.launch
      roslaunch pharmacy_mplus0_debug test_reporter.launch port:=8888
  -->

  <arg name="server_ip"   default="127.0.0.1" doc="TCP 上报目标 IP"/>
  <arg name="server_port" default="8888"      doc="TCP 端口"/>
  <arg name="car_id"      default="1"         doc="小车编号"/>
  <arg name="audio_dir"    default=""            doc="wav 音频目录，空字符串禁用"/>
  <arg name="audio_player" default="aplay"       doc="音频播放器"/>
  <arg name="allow_overlap" default="false"       doc="是否允许重叠播放"/>

  <!-- 假裁判服务端 -->
  <node name="tcp_fake_server"
        pkg="pharmacy_mplus0_debug" type="tcp_fake_server.py"
        output="screen">
    <param name="port" value="$(arg server_port)"/>
  </node>

  <!-- TCP 上报节点 -->
  <node name="tcp_reporter"
        pkg="pharmacy_mplus0" type="tcp_reporter.py"
        output="screen">
    <param name="server_ip"   value="$(arg server_ip)"/>
    <param name="server_port" value="$(arg server_port)"/>
    <param name="car_id"      value="$(arg car_id)"/>
    <param name="audio_dir"     value="$(arg audio_dir)"/>
    <param name="audio_player"  value="$(arg audio_player)"/>
    <param name="allow_overlap" value="$(arg allow_overlap)"/>
  </node>

</launch>
